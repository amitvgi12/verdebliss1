{
  "name": "verdebliss",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "playwright test --config=playwright.config.ts tests/a11y",
    "test:e2e": "playwright test --config=playwright.config.ts tests/e2e",
    "test:launch": "vitest run tests/launch-gates.test.ts",
    "test:visual": "playwright test --config=playwright.config.ts tests/visual",
    "test:live": "playwright test --config=playwright.live.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/prebuild.mjs",
    "schema:drift": "bash scripts/check-schema-drift.sh",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:a11y",
    "smoke:sitemap": "node scripts/smoke-test.mjs",
    "revalidate": "node scripts/trigger-revalidate.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.106.1",
    "@upstash/redis": "1.38.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "framer-motion": "12.39.0",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "6.12.3",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@lhci/cli": "0.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.4.0",
    "globals": "15.15.0",
    "jsdom": "29.1.1",
    "prettier": "3.3.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "overrides": {
    "postcss": "8.5.14",
    "ws": "8.20.1"
  }
}
