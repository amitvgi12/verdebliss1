# ──────────────────────────────────────────────────────────
# VerdeBliss — environment configuration
#
# Copy to .env.local for development. Set the same keys in Vercel
# (or your deploy provider) for staging/production. Never commit
# .env.local — it's in .gitignore.
# ──────────────────────────────────────────────────────────

# ── Supabase (browser-safe) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only for local/demo builds that intentionally use static catalogue
# fallback data without a Supabase project. Never enable for real production.
NEXT_PUBLIC_DEMO_MODE=

# ── Supabase (server-only) ────────────────────────────────
# Required for: server-side checkout, contact/newsletter persistence,
# refund verification, trusted chat order context, rate-limit DB store,
# webhook reconciliation DLQ.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase CLI / CI-only schema drift check ───────────
# Required by `npm run schema:drift` in GitHub Actions. These are not used by
# the storefront runtime and should live in GitHub repository secrets only.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# ── Distributed API rate limiting (server-only) ───────────
# Required for production bot/fraud controls across Vercel regions/instances.
# Use either Upstash Redis REST keys or Vercel KV REST aliases.
# URLs must be REST HTTPS endpoints, not redis:// connection strings.
# The limiter needs a writable token; KV_REST_API_READ_ONLY_TOKEN is not enough.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_REDIS_URL=
# KV_REST_API_KV_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# ── Razorpay (browser) ────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxx

# ── Razorpay (server-only) ────────────────────────────────
# RAZORPAY_KEY_ID is duplicated server-side intentionally so server code
# never has to read NEXT_PUBLIC_*. RAZORPAY_KEY_SECRET signs every order;
# RAZORPAY_WEBHOOK_SECRET verifies inbound webhook signatures.
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Gemini (server-only) ──────────────────────────────────
# Never expose with the NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your-gemini-key

# ── Cloudflare Turnstile (bot defence on contact + newsletter) ──
# Optional in development — when both are unset, server-side verification
# silently passes and the widget is not rendered. Required in production:
# missing config is reported at startup and protected APIs fail closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional log/observability routing ─────────────────────
# When SENTRY_DSN is set, lib/observability.ts forwards reportError /
# reportException emits structured `[ALERT]` / `[EXCEPTION]` log lines
# / `[EXCEPTION]` log lines. instrumentation.ts loads the runtime config.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Browser SDK uses NEXT_PUBLIC_SENTRY_DSN — typically the same DSN as the
# server. Splitting them lets you use a different (lower-volume) DSN for
# the browser if you want.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sentry build-time source-map upload (CI only — never commit auth token).
# If all three of SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT are set, next.config.ts
# wraps the build with the Sentry webpack plugin.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── On-demand ISR revalidation ────────────────────────────
# Shared secret between the post-deploy CI step and POST /api/revalidate.
# Generate with: openssl rand -hex 32
# Must also be added as a GitHub Actions secret (REVALIDATE_SECRET) and as a
# Vercel production environment variable so both sides match.
REVALIDATE_SECRET=

# ── Resend (transactional email) ──────────────────────────
# Required for order confirmation emails and invoice delivery.
# Get your key at resend.com/api-keys → "verdebliss" key with "Sending access".
# Without this key, emails are silently skipped — orders still complete.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address shown to customers. Must be a verified sender domain in Resend.
# After verifying verdebliss.com, use: orders@verdebliss.com
# Until then, the fallback is the Resend sandbox address (sends only to
# the account owner email).
ORDER_FROM_EMAIL=orders@verdebliss.com

# ── Newsletter double opt-in ───────────────────────────────
# POST endpoint that sends the confirmation email. The API sends:
# { email, confirmationUrl, source }. Production newsletter signups fail closed
# if this is unset, so nobody is marked subscribed without a confirmation path.
NEWSLETTER_CONFIRMATION_WEBHOOK_URL=
NEWSLETTER_CONFIRMATION_WEBHOOK_SECRET=

# ── Cloudflare origin gate (production hardening) ────────
# When set, proxy.ts rejects API requests that don't present the same
# secret in the x-cf-origin-secret header. Cloudflare adds this header at the
# edge via a Transform Rule. See CLOUDFLARE_WAF.md.
CF_ORIGIN_SECRET=

# ── COD fraud/serviceability controls ─────────────────────
# Comma-separated values. Block lists reject COD immediately; review prefixes
# place COD orders into a verification queue before dispatch.
COD_BLOCKED_PINCODES=
COD_BLOCKED_STATES=
COD_REVIEW_PIN_PREFIXES=194,68255,744,795,796,797,798,799
