# Supabase public browser keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-side service role key
# Required for secure checkout, contact/newsletter persistence, refunds, and trusted chat order context.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay browser key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxx

# Razorpay server credentials
# Required for server-side order creation and signature verification.
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Gemini — server-side only. Never expose with NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your-gemini-key
