# ──────────────────────────────────────────────────────────
# VerdeBliss — environment configuration
#
# Copy to .env.local for development. Set the same keys in Vercel
# (or your deploy provider) for staging/production. Never commit
# .env.local — it's in .gitignore.
# ──────────────────────────────────────────────────────────

# ── Supabase (browser-safe) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (server-only) ────────────────────────────────
# Required for: server-side checkout, contact/newsletter persistence,
# refund verification, trusted chat order context, rate-limit DB store,
# webhook reconciliation DLQ.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay (browser) ────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxx

# ── Razorpay (server-only) ────────────────────────────────
# RAZORPAY_KEY_ID is duplicated server-side intentionally so server code
# never has to read NEXT_PUBLIC_*. RAZORPAY_KEY_SECRET signs every order;
# RAZORPAY_WEBHOOK_SECRET verifies inbound webhook signatures.
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Gemini (server-only) ──────────────────────────────────
# Never expose with the NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your-gemini-key

# ── Cloudflare Turnstile (bot defence on contact + newsletter) ──
# Optional in development — when both are unset, server-side verification
# silently passes and the widget is not rendered. In production set both.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional log/observability routing ─────────────────────
# When SENTRY_DSN is set, lib/observability.ts forwards reportError /
# reportException emits structured `[ALERT]` / `[EXCEPTION]` log lines
# / `[EXCEPTION]` log lines. instrumentation.ts loads the runtime config.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Browser SDK uses NEXT_PUBLIC_SENTRY_DSN — typically the same DSN as the
# server. Splitting them lets you use a different (lower-volume) DSN for
# the browser if you want.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sentry build-time source-map upload (CI only — never commit auth token).
# If all three of SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT are set, next.config.ts
# wraps the build with the Sentry webpack plugin.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Cloudflare origin gate (production hardening) ────────
# When set, middleware.ts rejects API requests that don't present the same
# secret in the x-cf-origin-secret header. Cloudflare adds this header at the
# edge via a Transform Rule. See CLOUDFLARE_WAF.md.
CF_ORIGIN_SECRET=
