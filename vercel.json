{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "build": {
    "env": {
      "VERCEL_FORCE_NO_BUILD_CACHE": "1",
      "TURBO_FORCE": "true"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reconciliation-alert",
      "schedule": "0 1 * * *"
    }
  ]
}
